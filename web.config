<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config for IIS.
  Tells IIS to show our own /404.html whenever a page isn't found,
  instead of IIS's built-in "HTTP Error 404.0 - Not Found" page.
  Must sit in the SAME folder as index.html (the site root).
-->
<configuration>
  <system.webServer>
    <!-- IIS doesn't recognize .md by default and returns 404.3 (MIME
         type not allowed) even when the file exists. This registers it
         as a servable static file so post/data/*.md can be fetched. -->
    <staticContent>
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
      <!-- .json is normally already mapped by IIS, but this is a
           harmless safety net in case a stripped-down install doesn't
           have it — remove-then-add avoids a "duplicate entry" config
           error either way. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
